{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "owner": "dhruvv301292",
    "scheme": "nutrichat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Nutrition Assistant to use speech recognition to log meals by voice.",
        "NSMicrophoneUsageDescription": "Allow Nutrition Assistant to use the microphone to log meals by voice."
      },
      "bundleIdentifier": "com.dhruvvashisht.nutrichat",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.dhruvvashisht.nutrichat"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Nutrition Assistant to use the microphone to log meals by voice.",
          "speechRecognitionPermission": "Allow Nutrition Assistant to use speech recognition to log meals by voice."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "cff921b2-dd7b-47f6-8a04-70126ee2274c"
      }
    }
  }
}
